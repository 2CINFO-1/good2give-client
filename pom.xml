pipeline {
    agent any
    tools {
        maven 'M2_HOME'
    }
    stages {
        stage('GIT') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/2CINFO-1/good2give-client.git'
            }
        }
        stage('Build') {
            steps {
                dir('your-subdirectory') {
                    sh 'mvn clean package'
                }
            }
        }
    }
}
